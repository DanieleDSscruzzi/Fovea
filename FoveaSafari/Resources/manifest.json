{
  "manifest_version": 3,
  "name": "Fovea",
  "version": "1.0",
  "description": "Lente e soglia su qualsiasi sito: nitido solo dove appoggi il dito.",
  "default_locale": "it",
  "icons": {
    "48": "icona-48.png",
    "96": "icona-96.png",
    "128": "icona-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icona-48.png",
      "96": "icona-96.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fovea.js"
      ],
      "css": [
        "fovea.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}